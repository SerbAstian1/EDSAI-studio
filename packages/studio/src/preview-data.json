        "compositionFamilies": [
          {
            "name": "Grid & Proportion",
            "effect": "calm, structured, editorial",
            "structures": [
              {
                "id": "rule-of-thirds",
                "name": "Rule of Thirds",
                "family": "Grid & Proportion",
                "description": "frame divided into a 3×3 grid; place the subject/focal point on a gridline or intersection rather than dead-center. Default choice for natural-feeling balance without being static."
              },
              {
                "id": "golden-section-golden-ratio",
                "name": "Golden Section / Golden Ratio",
                "family": "Grid & Proportion",
                "description": "divisions based on the ~1.618 ratio rather than even thirds; slightly more refined/organic proportion than a plain thirds grid. Reach for this when the brief calls for \"premium\" or \"classical\" over \"modern/grid-y.\""
              },
              {
                "id": "golden-spiral-fibonacci-spiral",
                "name": "Golden Spiral / Fibonacci Spiral",
                "family": "Grid & Proportion",
                "description": "the golden ratio expressed as a spiral, leading the eye inward toward a focal point along a curved path rather than straight gridlines. Strong for imagery with implied depth or motion (staircases, natural forms, any subject with its own spiral logic)."
              },
              {
                "id": "spiral-section",
                "name": "Spiral Section",
                "family": "Grid & Proportion",
                "description": "a simpler nested-rectangle version of the golden proportion; use where the golden spiral's curve is too ornate for the deliverable (e.g. a UI grid vs. a poster)."
              }
            ]
          },
          {
            "name": "Radial & Focal",
            "effect": "draws attention to one point",
            "structures": [
              {
                "id": "radiating-radial",
                "name": "Radiating / Radial",
                "family": "Radial & Focal",
                "description": "lines or elements emanating from a single point; pulls the eye immediately to that point and implies energy, explosion, or importance. Strong for a hero product shot, a launch announcement, a single dominant CTA."
              },
              {
                "id": "focal-mass",
                "name": "Focal Mass",
                "family": "Radial & Focal",
                "description": "a cluster of small elements (dots, icons, a crowd) against a comparatively empty field; the density itself becomes the focal point, distinct from radial because there's no single origin point, just concentration vs. sparseness."
              },
              {
                "id": "circular",
                "name": "Circular",
                "family": "Radial & Focal",
                "description": "a strong circular or orbital shape frames or contains the subject; reads as complete, contained, protective, or cyclical. Common for badges, seals, product-hero isolation."
              }
            ]
          },
          {
            "name": "Line-Driven",
            "effect": "directs the eye along a path",
            "structures": [
              {
                "id": "converging-leading-lines",
                "name": "Converging / Leading Lines",
                "family": "Line-Driven",
                "description": "real or implied lines (a road, architecture, shadows) that converge toward a point, pulling the eye there. The strongest tool for \"make sure the eye lands *here*.\""
              },
              {
                "id": "diagonal-double-diagonal",
                "name": "Diagonal / Double Diagonal",
                "family": "Line-Driven",
                "description": "one or two diagonal axes across the frame; inherently more dynamic and tense than horizontal/vertical because diagonals read as instability-in-motion, not rest. Use when the brand energy is kinetic, urgent, or youthful — avoid when the brand needs to read as stable/trustworthy."
              },
              {
                "id": "vertical-lines",
                "name": "Vertical Lines",
                "family": "Line-Driven",
                "description": "repeated verticals (columns, trees, high-rises); read as aspiration, growth, or formality; can also feel like a barrier/cage depending on density and gap."
              },
              {
                "id": "horizontal-lines",
                "name": "Horizontal Lines",
                "family": "Line-Driven",
                "description": "repeated horizontals (horizon, shelving, stacked bands); read as calm, stability, rest — the default \"trustworthy\" line direction."
              },
              {
                "id": "cross",
                "name": "Cross",
                "family": "Line-Driven",
                "description": "one strong horizontal and one strong vertical intersecting; a very quiet, almost architectural balance point — good for restraint-heavy, minimal-brand compositions where a single intersection is the whole story."
              },
              {
                "id": "tunnel",
                "name": "Tunnel",
                "family": "Line-Driven",
                "description": "receding frame-within-frame lines (an archway, a corridor) that pull the eye toward a distant point; combines leading lines with actual depth compression — strong for \"reveal\" or \"destination\" messaging."
              }
            ]
          },
          {
            "name": "Weighted Shapes",
            "effect": "implies stability, tension, or motion through geometry",
            "structures": [
              {
                "id": "v-shape-v-arrangement",
                "name": "V-Shape / V-Arrangement",
                "family": "Weighted Shapes",
                "description": "elements forming a V, converging toward a base point; reads as funneling attention downward/inward, or (inverted) as expansion/opening upward."
              },
              {
                "id": "pyramid-triangle-composition",
                "name": "Pyramid / Triangle Composition",
                "family": "Weighted Shapes",
                "description": "a stable, wide-based triangular arrangement; the most classically \"stable and grounded\" weighted shape — use for anything needing gravitas, permanence, trust."
              },
              {
                "id": "golden-triangles-harmonious-triangles",
                "name": "Golden Triangles / Harmonious Triangles",
                "family": "Weighted Shapes",
                "description": "diagonal-plus-perpendicular triangle divisions of the frame (not the same as a simple pyramid); used to divide asymmetric compositions while keeping proportional harmony — a more dynamic cousin of the golden section for diagonal-heavy imagery."
              },
              {
                "id": "l-arrangement",
                "name": "L-Arrangement",
                "family": "Weighted Shapes",
                "description": "elements forming an L, anchoring two adjoining edges of the frame and leaving the opposite corner open as negative space; a strong, quiet asymmetric-balance move."
              },
              {
                "id": "c-shape",
                "name": "C-Shape",
                "family": "Weighted Shapes",
                "description": "an arc or C-curve of elements around a partially enclosed negative-space center; frames a focal point without fully surrounding it the way Circular does — feels more organic/gestural than the closed Circular structure."
              },
              {
                "id": "compound-curve-s-curve",
                "name": "Compound Curve / S-Curve",
                "family": "Weighted Shapes",
                "description": "an S-shaped path through the frame; the classic \"graceful, meandering, editorial\" path — strong for fashion, lifestyle, anything wanting elegance-in-motion over the Diagonal family's raw energy."
              }
            ]
          },
          {
            "name": "Balance Logic",
            "effect": "how weight is distributed, independent of shape",
            "structures": [
              {
                "id": "symmetry",
                "name": "Symmetry",
                "family": "Balance Logic",
                "description": "both halves mirror; reads as order, formality, perfection, sometimes coldness if overused. Strongest where the brand truth is precision/reliability."
              },
              {
                "id": "asymmetry-balance-unequal-massing",
                "name": "Asymmetry / Balance (unequal massing)",
                "family": "Balance Logic",
                "description": "unequal elements balanced by weight rather than mirrored form (a large shape on one side offset by a smaller-but-denser or higher-contrast element on the other); reads as more human, more alive than symmetry, but requires the weights to be genuinely felt as equal — this is the difference between \"balance\" (intentional, felt-equal) and \"unbalanced\" (a genuine failure state, one side visually heavier with no compensating device on the other)."
              },
              {
                "id": "juxtaposition",
                "name": "Juxtaposition",
                "family": "Balance Logic",
                "description": "two elements placed close together specifically to invite comparison or contrast (old/new, small/large, rough/refined); the composition's whole point is the relationship between the two things, not either one alone."
              },
              {
                "id": "contrast",
                "name": "Contrast",
                "family": "Balance Logic",
                "description": "light/dark, large/small, rough/smooth, or busy/empty pushed deliberately far apart within the same frame to create drama and hierarchy; distinct from Juxtaposition in that contrast is about visual difference driving hierarchy, not necessarily inviting a comparison of meaning."
              }
            ]
          },
          {
            "name": "Depth & Frame",
            "effect": "uses the space itself, not just shapes in it",
            "structures": [
              {
                "id": "negative-space",
                "name": "Negative Space",
                "family": "Depth & Frame",
                "description": "deliberate empty area that isolates and emphasizes the subject; absence functioning as an active compositional element, not leftover space (see Department 14's identical requirement)."
              },
              {
                "id": "framing-frame-within-frame",
                "name": "Framing / Frame Within Frame",
                "family": "Depth & Frame",
                "description": "using an element within the scene (a doorway, an arch, foliage) to create a frame around the subject, emphasizing it and adding depth."
              },
              {
                "id": "fill-the-frame",
                "name": "Fill the Frame",
                "family": "Depth & Frame",
                "description": "the opposite move: subject/texture fills the entire frame edge-to-edge with no breathing room, for maximum intimacy/intensity or a texture/pattern-forward brand moment."
              },
              {
                "id": "depth-foreground-midground-background-layering",
                "name": "Depth (foreground/midground/background layering)",
                "family": "Depth & Frame",
                "description": "deliberate layering so the eye reads three distinct distance planes rather than one flat plane; makes a static 2D surface feel dimensional."
              },
              {
                "id": "patterns-repetition",
                "name": "Patterns & Repetition",
                "family": "Depth & Frame",
                "description": "a repeated unit (texture, grid of icons, architectural repetition) establishes rhythm; a single deliberate break in the pattern becomes the focal point *because* everything else repeats."
              },
              {
                "id": "figure-to-ground",
                "name": "Figure to Ground",
                "family": "Depth & Frame",
                "description": "a single clear silhouette/subject stands unambiguously apart from its background at a glance — the most basic test any composition should pass regardless of which other structure is also in play (see Department 14's Figure-Ground Clarity requirement)."
              }
            ]
          }
        ],
