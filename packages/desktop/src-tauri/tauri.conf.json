{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EDSAI Studio",
  "version": "0.1.0",
  "identifier": "studio.edsai.desktop",
  "build": {
    "frontendDist": "../../studio/dist"
  },
  "app": {
    "windows": [
      {
        "title": "EDSAI Studio",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost http://localhost:4317 http://127.0.0.1:4317; img-src 'self' data:; style-src 'self' 'unsafe-inline'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Design intelligence workstation"
  }
}
