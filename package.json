{
  "name": "edsai-studio",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:rehearse": "node scripts/dev.mjs --rehearse",
    "dev:studio-only": "pnpm --filter @edsai/studio dev",
    "build": "pnpm -r build",
    "start": "node packages/api/dist/bin/serve.js",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "corpus:diff": "pnpm --filter @edsai/rubric corpus:diff"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@types/node": "^22.15.3"
  }
}
