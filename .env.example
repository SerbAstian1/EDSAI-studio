OPENAI_API_KEY=
# Balanced default for normal pipeline work.
EDSAI_MODEL=gpt-6-sol
# Optional premium route for the brand decisions that feed Brand Hub.
# Leave blank to run every department on EDSAI_MODEL.
EDSAI_BRAND_MODEL=
EDSAI_BRAND_MODEL_DEPARTMENTS=1,2,5,12,13,14
# Lower effort reduces hidden reasoning tokens. Use "default" to let the model decide.
EDSAI_REASONING_EFFORT=low
# Runaway guard per model response; the previous hard-coded limit was 64000.
EDSAI_MAX_OUTPUT_TOKENS=16000

# Optional marked placeholder mode; it takes precedence over the API key.
EDSAI_REHEARSAL=

# Restrict setup and sign-in before exposing the server publicly.
EDSAI_SIGNIN_ALLOW=
